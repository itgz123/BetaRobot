{
  // 启动调试的快捷键是F5
  //
  // 使用流程：
  // 1. 修改 user_cfg.h 中的 APP_NAME 选择要调试的应用
  // 2. F5 启动调试 —— 会自动构建当前 app 并将其产物复制到 build/active/Debug/
  //
  // 说明：路径全部固定，无需选择应用或开发板。
  //       开发板相关的 svd / openocd 配置由 CMake 按 app_cfg.h 的 DEVELOPMENT_BOARD 复制。
  "version": "0.2.0",
  "configurations": [
    // ==================== DAPlink - Launch ====================
    {
      "name": "DAPlink - Launch",
      "type": "cortex-debug",
      "request": "launch",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/active/Debug/BetaRobot.elf",
      "svdFile": "${workspaceFolder}/build/active/Debug/device.svd",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/build/active/Debug/openocd_daplink.cfg"
      ],
      "runToEntryPoint": "main",
      "rtos": "FreeRTOS",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    },
    // ==================== DAPlink - Launch (RTT) ====================
    {
      "name": "DAPlink - Launch (RTT)",
      "type": "cortex-debug",
      "request": "launch",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/active/Debug/BetaRobot.elf",
      "svdFile": "${workspaceFolder}/build/active/Debug/device.svd",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/build/active/Debug/openocd_daplink.cfg"
      ],
      "runToEntryPoint": "main",
      "rtos": "FreeRTOS",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "name": "RTT Channel 0"
          }
        ]
      }
    },
    // ==================== DAPlink - Attach ====================
    {
      "name": "DAPlink - Attach",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/active/Debug/BetaRobot.elf",
      "svdFile": "${workspaceFolder}/build/active/Debug/device.svd",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/build/active/Debug/openocd_daplink.cfg"
      ],
      "rtos": "FreeRTOS"
    },
    // ==================== DAPlink - Attach (RTT) ====================
    {
      "name": "DAPlink - Attach (RTT)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/active/Debug/BetaRobot.elf",
      "svdFile": "${workspaceFolder}/build/active/Debug/device.svd",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/build/active/Debug/openocd_daplink.cfg"
      ],
      "rtos": "FreeRTOS",
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "name": "RTT Channel 0"
          }
        ]
      }
    }
  ]
}
