{
  // ==================== BetaRobot 项目配置 ====================
  // 编译相关
  "betaRobot.cmakeCommand": "cmake",
  "betaRobot.ninjaCommand": "ninja",
  "betaRobot.buildJobs": 24,
  "files.associations": {
    "*.h": "c",
    "*.c": "c",
    "*.hpp": "cpp",
    "*.cpp": "cpp"
  },
  "C_Cpp.autoAddFileAssociations": false // 防止 C/C++ 插件自动修改文件关联
}
